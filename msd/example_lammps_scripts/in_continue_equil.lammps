log log_continue.P$P

atom_style atomic 
units metal
boundary p p p 
newton on 

# Read from restart file instead of data file
read_restart restart_4000000.dat

### interactions
pair_style flare 
pair_coeff * * ../lmp.flare 

mass 1 12.011000 
mass 2 28.085000 

thermo_style custom step temp press cpu pxx pyy pzz pxy pxz pyz ke pe etotal vol lx ly lz cellalpha cellbeta cellgamma atoms
thermo 1000
timestep 0.0005
restart 100000 restart_cont_*.dat

# Groups
group carbon type 1
group silicon type 2

# MSD computes
compute msd_C carbon msd com yes
compute msd_Si silicon msd com yes
variable t equal step*dt

# Print MSD every 1000 steps
fix msd_out all print 1000 &
  "$(step*dt) $(c_msd_C[4]) $(c_msd_Si[4])" &
  append msd_continue_P${P}.txt screen no title "# time(ps) MSD_C MSD_Si"

### Continue equilibration at Ttarget for another 3ns
fix 6 all npt temp ${Ttarget} ${Ttarget} $(100.0*dt) ${PressConstraint} $P $P $(1000.0*dt) flip no
dump 6 all custom 1000 4contequil.bin id type xu yu zu vx vy vz
run 6000000 # 3000 ps

unfix 6
undump 6