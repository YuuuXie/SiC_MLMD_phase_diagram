log log.P$P

atom_style atomic 
units metal
boundary p p p 
#atom_modify sort 0 0.0 
newton on 

read_data data.lammps 
replicate 20 20 20
# replicate 10 10 10

### interactions

pair_style flare 
pair_coeff * * ../lmp.flare 

# compute unc all flare/std/atom L_inv_lmp.flare sparse_desc_lmp.flare
# compute MaxUnc all reduce max c_unc

mass 1 12.011000 
mass 2 28.085000 

thermo_style custom step temp press cpu pxx pyy pzz pxy pxz pyz ke pe etotal vol lx ly lz cellalpha cellbeta cellgamma atoms    #c_MaxUnc
thermo 1000
timestep 0.0005
restart 100000 restart_*.dat

# Groups
group carbon type 1
group silicon type 2

# MSD computes
compute msd_C carbon msd com yes
compute msd_Si silicon msd com yes
variable t equal step*dt

# Print MSD every 1000 steps
fix msd_out all print 1000 &
  "$(step*dt) $(c_msd_C[4]) $(c_msd_Si[4])" &
  append msd_P${P}.txt screen no title "# time(ps) MSD_C MSD_Si"

### start at 5000K
velocity all create 5000 ${SEED} rot yes dist gaussian
fix 1 all npt temp 5000 5000 $(100.0*dt) ${PressConstraint} $P $P $(1000.0*dt) flip no
dump 1 all custom 1000 1start.bin id type xu yu zu vx vy vz
run   10000 # report performance
run  990000
unfix 1
undump 1

### Cool down to Ttarget
fix 4 all npt temp 5000 ${Ttarget} $(100.0*dt) ${PressConstraint} $P $P $(1000.0*dt) flip no
dump 4 all custom 1000 2cooldown.bin id type xu yu zu vx vy vz
run 1000000 # 500 ps

### Equilibrate at Ttarget
unfix 4
undump 4
fix 5 all npt temp ${Ttarget} ${Ttarget} $(100.0*dt) ${PressConstraint} $P $P $(1000.0*dt) flip no
dump 5 all custom 1000 3coolend.bin id type xu yu zu vx vy vz
run 2000000 # 1000 ps

