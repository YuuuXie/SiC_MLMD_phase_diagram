
atom_style atomic
units metal
boundary p p p
#atom_modify sort 0 0.0
newton on

read_data data.lammps
Reading data file ...
  triclinic box = (0 0 0) to (4.3790145 4.3790145 4.3790145) with tilt (-0 0 0)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  8 atoms
  read_data CPU = 0.007 seconds
replicate 10 10 10
Replication is creating a 10x10x10 = 1000 times larger system...
  triclinic box = (0 0 0) to (43.790145 43.790145 43.790145) with tilt (-0 0 0)
  1 by 1 by 1 MPI processor grid
  8000 atoms
  replicate CPU = 0.003 seconds
# replicate 10 10 10

### interactions

pair_style flare
pair_coeff * * ../../lmp.flare
Reading potential file ../../lmp.flare with DATE: Thu

# compute unc all flare/std/atom L_inv_lmp.flare sparse_desc_lmp.flare
# compute MaxUnc all reduce max c_unc

mass 1 12.011000
mass 2 28.085000

thermo_style custom step temp press cpu pxx pyy pzz pxy pxz pyz ke pe etotal vol lx ly lz cellalpha cellbeta cellgamma atoms    #c_MaxUnc
thermo 1000
timestep 0.0005
restart 100000 restart_*.dat

# Groups
group carbon type 1
4000 atoms in group carbon
group silicon type 2
4000 atoms in group silicon

# MSD computes
compute msd_C carbon msd com yes
compute msd_Si silicon msd com yes
variable t equal step*dt

# Print MSD every 1000 steps
fix msd_out all print 1000   "$(step*dt) $(c_msd_C[4]) $(c_msd_Si[4])"   append msd_P${P}.txt screen no title "# time(ps) MSD_C MSD_Si"
fix msd_out all print 1000   "$(step*dt) $(c_msd_C[4]) $(c_msd_Si[4])"   append msd_P10000.txt screen no title "# time(ps) MSD_C MSD_Si"

### start at 5000K
velocity all create $T ${SEED} rot yes dist gaussian
velocity all create 4100 ${SEED} rot yes dist gaussian
velocity all create 4100 8723 rot yes dist gaussian
fix 1 all npt temp $T $T $(100.0*dt) aniso $P $P $(1000.0*dt)
fix 1 all npt temp 4100 $T $(100.0*dt) aniso $P $P $(1000.0*dt)
fix 1 all npt temp 4100 4100 $(100.0*dt) aniso $P $P $(1000.0*dt)
fix 1 all npt temp 4100 4100 0.050000000000000002776 aniso $P $P $(1000.0*dt)
fix 1 all npt temp 4100 4100 0.050000000000000002776 aniso 10000 $P $(1000.0*dt)
fix 1 all npt temp 4100 4100 0.050000000000000002776 aniso 10000 10000 $(1000.0*dt)
fix 1 all npt temp 4100 4100 0.050000000000000002776 aniso 10000 10000 0.5
dump 1 all custom 1000 1npt.bin id type x y z vx vy vz
run   10000 # report performance

